# ---- Model provider (config lives here, never in orchestration code) ----
# Provider adapter to load: anthropic | fake
AP_LLM_PROVIDER=anthropic
AP_LLM_MODEL=claude-sonnet-5
AP_LLM_MAX_TOKENS=2048
AP_LLM_TIMEOUT_SECONDS=30
AP_LLM_MAX_RETRIES=2
# API key is read from the provider's standard variable. Leave empty in this file.
ANTHROPIC_API_KEY=

# ---- Agent budget ----
AP_MAX_STEPS=12
AP_MAX_TOOL_CALLS=10

# ---- Retrieval ----
AP_CORPUS_DIR=./finance_rag_corpus
AP_INDEX_DIR=./data/index
AP_RETRIEVAL_TOP_K=6
# bm25 | hybrid  (hybrid adds local sentence-transformer embeddings, no external API)
AP_RETRIEVAL_MODE=bm25

# ---- Persistence & observability ----
AP_DB_PATH=./data/runtime/ap_agent.db
AP_LOG_LEVEL=INFO
AP_LOG_FORMAT=json

# ---- Mock tool fault injection (used by FIN-004 fixture) ----
AP_TOOL_TIMEOUT_SECONDS=2
AP_TOOL_MAX_RETRIES=2
