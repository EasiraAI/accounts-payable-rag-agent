# Example environment for the accounts-payable processing agent.
# Copy to .env and adjust. Contains no secrets: the API key line is deliberately blank.
#
# Every value below is a default that the application already uses, so the service runs
# with no .env file at all. The file exists to document what is configurable and where.

# ---- Model provider -------------------------------------------------------------------
# Provider and model names appear here and in no other file. Orchestration code reads
# Settings and never names a vendor, which is what makes the model swappable without
# touching control flow (docs/adr/0005-llm-provider-abstraction.md).
#
#   fake      deterministic adapter. No network, no cost. Used by every test tier and by
#             the default evaluation run. Safety properties are asserted against it
#             because they must hold for any model output, including hostile output.
#   anthropic live Claude via the official SDK, using forced tool use for structured
#             output. Requires ANTHROPIC_API_KEY.
AP_LLM_PROVIDER=fake
AP_LLM_MODEL=claude-sonnet-5
AP_LLM_MAX_TOKENS=2048
AP_LLM_TIMEOUT_SECONDS=30
AP_LLM_MAX_RETRIES=2

# Read from the provider's conventional variable rather than an AP_-prefixed one, so
# standard tooling and CI secrets work unchanged. Leave blank here; never commit a key.
ANTHROPIC_API_KEY=

# ---- Agent budget ---------------------------------------------------------------------
# Derived from the phase plan, not chosen as round numbers, so exhausting either means
# something genuinely unexpected happened. See src/ap_agent/orchestration/phases.py for
# the attempt-by-attempt derivation of 16.
#
# Retries spend the tool budget. A retry that cost nothing would make the budget describe
# an intention rather than a bound.
AP_MAX_STEPS=12
AP_MAX_TOOL_CALLS=16

# ---- Retrieval ------------------------------------------------------------------------
AP_CORPUS_DIR=./finance_rag_corpus
AP_INDEX_DIR=./data/index
AP_RETRIEVAL_TOP_K=6

# bm25   lexical only. No model download, fully deterministic, and the default because
#        queries in this domain quote the policy text rather than paraphrasing it.
# hybrid adds local sentence-transformer embeddings fused by reciprocal rank. Requires
#        the optional 'hybrid' extra (about 100 MB of model weights).
AP_RETRIEVAL_MODE=bm25

# Multiplier applied to a superseded document's lexical score. This is what ranks the
# current authority matrix above the version superseded on 1 August 2026; no ranking
# function can know that, because the difference is a date in the front matter.
AP_SUPERSEDED_SCORE_FACTOR=0.3

# ---- Persistence and observability ----------------------------------------------------
AP_DB_PATH=./data/runtime/ap_agent.db
AP_LOG_LEVEL=INFO
AP_LOG_FORMAT=json

# ---- Tool reliability -----------------------------------------------------------------
# The FIN-004 fixture injects a timeout on every attempt, so these values determine how
# many attempts that case records: tool_max_retries + 1.
AP_TOOL_TIMEOUT_SECONDS=2.0
AP_TOOL_MAX_RETRIES=2
AP_TOOL_RETRY_BACKOFF_SECONDS=0.05
